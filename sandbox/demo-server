#!/bin/sh
# Interactive demo for 0.2.3: tam-last --server and --client.
# Starts a private server on a temporary socket, lets you spawn client
# windows that share one process & font cache, and cleans up on exit.
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$DIR/.." && pwd)
BIN="$ROOT/build/tam-last"

if [ "${1:-}" != "--in-term" ]; then
	exec "$BIN" -e "$0" --in-term
fi

SOCK=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/tam-last-demo-server.XXXXXX.sock")
"$BIN" --server --socket "$SOCK" &
SRV_PID=$!
cleanup() {
	kill -TERM "$SRV_PID" 2>/dev/null || true
	wait "$SRV_PID" 2>/dev/null || true
	rm -f "$SOCK"
}
trap cleanup EXIT INT TERM

i=0
while [ ! -S "$SOCK" ] && [ "$i" -lt 50 ]; do
	sleep 0.05
	i=$((i + 1))
done
if [ ! -S "$SOCK" ]; then
	printf '\033[1;31mFailed to start tam-last --server on %s\033[0m\n' "$SOCK"
	printf 'Press Enter to return...'
	IFS= read -r _ || true
	exit 1
fi

count=0
while :; do
	printf '\033[2J\033[H'
	printf '\033[1;36mtam-last 0.2.3 — Server Mode Demo\033[0m\n\n'
	printf '  Server PID:   \033[33m%s\033[0m\n' "$SRV_PID"
	printf '  Socket:       \033[33m%s\033[0m\n' "$SOCK"
	printf '  Windows sent: \033[33m%s\033[0m\n\n' "$count"
	printf '  \033[1;32m1\033[0m  Open a new client window (shell in %s)\n' "$ROOT"
	printf '  \033[1;32m2\033[0m  Open a client window with Gruvbox config (sandbox/theme-gruvbox.ini)\n'
	printf '  \033[1;32m3\033[0m  Run a short command via --client and print its exit status (7)\n'
	printf '  \033[1;32mq\033[0m  Stop demo server and return\n\n'
	printf 'Choose [1-3, q]: '

	IFS= read -r ch || break
	case "$ch" in
	1)
		count=$((count + 1))
		"$BIN" --client --no-wait --socket "$SOCK" || true
		;;
	2)
		count=$((count + 1))
		"$BIN" --client --no-wait --socket "$SOCK" -c "$DIR/theme-gruvbox.ini" || true
		;;
	3)
		count=$((count + 1))
		set +e
		"$BIN" --client --socket "$SOCK" -e sh -c 'printf "Client window on server PID %s\nExiting with 7 in 1s...\n" '"$SRV_PID"'; sleep 1; exit 7'
		rc=$?
		set -e
		printf '\nClient exited with status: \033[1;33m%d\033[0m (expected 7). Press Enter...' "$rc"
		IFS= read -r _ || true
		;;
	q | Q)
		break
		;;
	esac
done
