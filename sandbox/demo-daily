#!/bin/sh
# Interactive demo for tam-last 0.2.2:
#   - Scrollback search (Ctrl+Shift+R)
#   - Keyboard URL mode (Ctrl+Shift+O, Shift+key to copy, Ctrl+Click on OSC 8)
#   - Desktop notifications (OSC 777 and OSC 99 via notify-send)
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$DIR/.." && pwd)

if [ "${1:-}" != "--in-term" ]; then
	exec "$ROOT/build/tam-last" --notify yes -e "$0" --in-term
fi

printf '\033[2J\033[H'
printf '\033[1;36m=== tam-last 0.2.2: Search, URL Mode & Notifications ===\033[0m\n\n'

# Populate scrollback with searchable lines (ASCII, mixed case, Unicode).
i=1
while [ "$i" -le 35 ]; do
	case "$i" in
	5)  printf '  [%02d] Needle in scrollback: tam-last search target (lowercase)\n' "$i" ;;
	14) printf '  [%02d] NEEDLE in scrollback: smart-case uppercase test\n' "$i" ;;
	22) printf '  [%02d] Unicode search target: caf\303\251 & \346\227\245\346\234\254\350\252\236\n' "$i" ;;
	30) printf '  [%02d] Another needle near the live screen\n' "$i" ;;
	*)  printf '  [%02d] Scrollback filler line %d\n' "$i" "$i" ;;
	esac
	i=$((i + 1))
done

printf '\n\033[1;33m1. Scrollback Search (Ctrl+Shift+R):\033[0m\n'
printf '   Type "needle" (smart-case matches all 3), "NEEDLE" (exact), or "caf\303\251".\n'
printf '   Ctrl+R / Up = older, Ctrl+S / Down = newer, Enter = select, Esc = cancel.\n\n'

printf '\033[1;33m2. Keyboard URL Mode (Ctrl+Shift+O):\033[0m\n'
printf '   Plain URL:      https://tamlinux.org/docs (with trailing period).\n'
printf '   Balanced parens: https://en.wikipedia.org/wiki/Terminal_emulator_(Unix)\n'
printf '   OSC 8 link:     \033]8;;https://github.com/greenermoose/tam-last\033\\tam-last on GitHub\033]8;;\033\\  (also try Ctrl+Click)\n'
printf '   Mailto:         mailto:hello@example.org\n'
printf '   Tip: hold Shift on the final hint key to copy URL instead of opening.\n\n'

printf '\033[1;33m3. Desktop Notifications (OSC 777 & OSC 99):\033[0m\n'
printf '   Note: default policy is notify=unfocused; launch directly or with --notify yes.\n'
printf '   [7] Send OSC 777 notification\n'
printf '   [9] Send OSC 99 notification (chunked + base64 + critical)\n'
printf '   [u] Send OSC 99 after 3s (switch focus away to test notify=unfocused)\n'
printf '   [q] Return to menu\n\n'

while :; do
	printf 'Press 7, 9, u, or q (or use Ctrl+Shift+R / Ctrl+Shift+O): '
	old=$(stty -g 2>/dev/null || true)
	if [ -n "$old" ]; then
		stty raw -echo
		ch=$(dd bs=1 count=1 2>/dev/null || true)
		stty "$old"
		printf '%s\n' "$ch"
	else
		IFS= read -r ch || break
	fi
	case "$ch" in
	7)
		printf '\033]777;notify;tam-last 0.2.2;Hello from OSC 777!\033\\'
		printf '  -> Sent OSC 777 notification.\n'
		;;
	9)
		# Chunked OSC 99: title (d=0), then base64 body ("Hello from OSC 99!") with u=2.
		printf '\033]99;i=demo:p=title:d=0:u=2;tam-last OSC 99\033\\'
		printf '\033]99;i=demo:p=body:d=1:e=1;SGVsbG8gZnJvbSBPU0MgOTkh\033\\'
		printf '  -> Sent chunked base64 OSC 99 notification (critical).\n'
		;;
	u | U)
		printf '  -> Waiting 3 seconds (unfocus this window now)...\n'
		sleep 3
		printf '\033]99;p=title:d=0:o=unfocused;tam-last background\033\\'
		printf '\033]99;p=body:d=1;Background task finished!\033\\'
		printf '  -> Sent unfocused OSC 99 notification.\n'
		;;
	q | Q | '')
		break
		;;
	esac
done
