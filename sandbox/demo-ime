#!/bin/sh
# Interactive input method (text-input-v3) demo (0.1.3).
# Launches tam-last --keys with a raw UTF-8 receiver so you can see
# preedit overlays, IME candidate popup tracking, and exact committed bytes.
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$DIR/.." && pwd)

if [ "${1:-}" != "--in-term" ]; then
	exec "$ROOT/build/tam-last" --keys -e "$0" --in-term
fi

printf '\033[2J\033[H'
printf '\033[1;36m=== tam-last 0.1.3: Input Methods (text-input-v3) ===\033[0m\n\n'
printf '  This window enables zwp_text_input_v3 with content purpose = terminal\n'
printf '  and reports the cursor cell rectangle to the compositor.\n\n'
printf '  Try with fcitx5 (or another Wayland text-input-v3 IME):\n'
printf '    1. Toggle your IME and type a composing sequence.\n'
printf '       Watch the underlined preedit overlay at the cursor and the\n'
printf '       bottom --keys bar showing "ime preedit ...".\n'
printf '    2. Commit the text to see the exact UTF-8 bytes and codepoints\n'
printf '       received by this program below ("ime commit ...").\n'
printf '    3. Unfocus this window mid-preedit to verify preedit clears.\n'
printf '    4. Press Ctrl+C or Ctrl+D to exit.\n\n'
printf '  Input> '

python3 -u -c '
import os, sys, termios, tty

fd = sys.stdin.fileno()
old = termios.tcgetattr(fd)
try:
    tty.setraw(fd)
    while True:
        data = os.read(fd, 256)
        if not data:
            break
        if b"\x03" in data or b"\x04" in data:
            sys.stdout.write("\r\nDone.\r\n")
            sys.stdout.flush()
            break
        text = data.decode("utf-8", errors="replace")
        hexstr = " ".join(f"{b:02x}" for b in data)
        cps = " ".join(f"U+{ord(ch):04X}" for ch in text)
        vis = "".join(ch if ord(ch) >= 0x20 and ch != "\x7f" else f"\\x{ord(ch):02x}" for ch in text)
        sys.stdout.write(f"\r\n  got: {vis}  ({cps})  [{hexstr}]\r\n  Input> ")
        sys.stdout.flush()
finally:
    termios.tcsetattr(fd, termios.TCSADRAIN, old)
'
